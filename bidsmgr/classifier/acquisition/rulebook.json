{
  "version": 1,
  "about": "What each name looks like in the acquisition parameters and in the series name. Each line is one piece of evidence: a feature, a test, a weight (positive for, negative against) and a sentence. Ranges named cfg:<section>.<field> come from the classifier settings. The user's edits are a delta on top of this file.",
  "candidates": {
    "anat/T1w": {
      "label": "T1-weighted",
      "evidence": [
        {
          "source": "parameters",
          "feature": "is_epi",
          "is": false,
          "weight": 0.5,
          "why": "not an EPI readout"
        },
        {
          "source": "parameters",
          "feature": "t1_ir_gre",
          "is": true,
          "weight": 3.5,
          "why": "an inversion-recovery gradient echo (MPRAGE-like)"
        },
        {
          "source": "parameters",
          "feature": "t1_se",
          "is": true,
          "weight": 3.0,
          "why": "a spin echo with a short echo and repetition time"
        },
        {
          "source": "parameters",
          "feature": "spoiled_2d_t1",
          "is": true,
          "weight": 2.5,
          "why": "a gradient echo with a short echo, a short repetition time and a large flip angle"
        },
        {
          "source": "parameters",
          "feature": "mt_short_te",
          "is": true,
          "weight": 1.0,
          "why": "a magnetisation-transfer pulse before a short echo (MT-weighted T1, as for neuromelanin)"
