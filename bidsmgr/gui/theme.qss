/* =====================================================================
 * BIDS Manager stylesheet, one template for every theme.
 *
 * Token-based template. The Python `ThemeManager` calls
 * `string.Template(this).safe_substitute(...)` with the active palette
 * (`theme_manager.PALETTES`, seven themes) plus the images drawn in its
 * colours (`theme_assets`: $icon_check, $icon_partial, $icon_radio,
 * $icon_chevron_down, $icon_chevron_up, $icon_chevron_right, ...).
 *
 * Fonts: no rule names a family except "JetBrains Mono" for code, logs and
 * raw text; everything else inherits the bundled Inter (`typefaces`).
 *
 * Tokens used:
 *   bg surface surface2 surface3 border subtle text dim muted
 *   accent success warning error purple teal
 *   accent_bg accent_border
 *   success_bg success_border
 *   warning_bg warning_border
 *   error_bg error_border
 *   purple_bg purple_border
 *   teal_bg teal_border
 *   primary_btn_text  (black-on-accent for dark, white-on-accent for light)
 *   pressed_alpha     (button :pressed background)
 * ===================================================================== */

/* ---------- App-level base ---------- */
QMainWindow,
QWidget#central {
    background: $bg;
    color: $text;
}

QWidget {
    color: $text;
    selection-background-color: $accent_bg;
    selection-color: $text;
}

/* Generic font-size baseline. Any widget that does not carry an
 * object-name-specific rule below picks up 11 px here, so nothing can
 * leak to the QApplication default font (which varies across platforms
 * even with ``setPixelSize`` because the underlying font family differs
 * on macOS / Windows / Linux). Object-name selectors win on specificity
 * so this is purely a safety net. */
QPushButton,
QLabel,
QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox,
QPlainTextEdit,
QTextEdit,
QTableView,
QTableView::item,
QTreeView,
QTreeView::item,
QTreeWidget,
QTreeWidget::item,
QListView,
QListWidget,
QCheckBox,
QRadioButton,
QGroupBox,
QToolButton,
QMenu,
QMenuBar,
QMenuBar::item,
QStatusBar {
    font-size: 11px;
}

QToolTip {
    background: $surface2;
    color: $text;
    border: 1px solid $border;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 11px;
}

/* ---------- Checkboxes and radio buttons (global) ----------
 * Unstyled, these fall back to the platform control, which does not follow
 * the palette. Checked is the accent with a TICK (an image drawn in the
 * theme's colours by theme_assets): a filled square alone read as a colour
 * swatch beside a legend dot. Item views (trees, lists, tables) share it. */
QCheckBox::indicator,
QRadioButton::indicator,
QAbstractItemView::indicator {
    width: 14px; height: 14px;
    border: 1px solid $input_border;
    background: $surface2;
    border-radius: 4px;
}
QRadioButton::indicator { border-radius: 8px; }

QCheckBox::indicator:hover,
QRadioButton::indicator:hover,
QAbstractItemView::indicator:hover { border: 1px solid $accent; }

QCheckBox::indicator:checked,
QAbstractItemView::indicator:checked {
    background: $accent;
    border: 1px solid $accent;
    image: $icon_check;
}
QRadioButton::indicator:checked {
    background: $accent;
    border: 1px solid $accent;
    image: $icon_radio;
}
QCheckBox::indicator:indeterminate,
QAbstractItemView::indicator:indeterminate {
    background: $accent_bg;
    border: 1px solid $accent;
    image: $icon_partial;
}
QCheckBox::indicator:disabled,
QRadioButton::indicator:disabled,
QAbstractItemView::indicator:disabled {
    background: $surface;
    border: 1px solid $border;
}
QCheckBox::indicator:checked:disabled,
QAbstractItemView::indicator:checked:disabled {
    background: $surface3;
    image: $icon_check_disabled;
}
QCheckBox, QRadioButton { spacing: 7px; }
QCheckBox:disabled,
QRadioButton:disabled { color: $muted; }

/* ---------- Dropdowns (global, rounded + stylish) ----------
 * Every plain QComboBox gets a rounded, themed box + a rounded popup list
 * with rounded item selection (mirroring the project dropdown look).
 * Object-name'd combos (#ent-input, #project-switcher) keep their own
 * more-specific rules on top of this. */
/* ---------------------------------------------------------------------------
 * Text inputs
 *
 * There was no generic QLineEdit rule at all: only per-object-name ones, so a
 * plain line edit fell back to the platform default and, on the near-black dark
 * surface, showed no outline worth the name. A form of twenty such boxes then
 * read as one undifferentiated block. $input_border is brighter than $border on
 * purpose: the panel border separates regions quietly, an input has to be
 * findable.
 * ------------------------------------------------------------------------ */
QLineEdit {
    background: $surface2;
    color: $text;
    border: 1px solid $input_border;
    border-radius: 6px;
    padding: 3px 8px;
    min-height: 20px;
    selection-background-color: $accent_bg;
}
QLineEdit:hover { border-color: $accent_border; }
QLineEdit:focus { border-color: $accent; }
QLineEdit:disabled, QLineEdit:read-only {
    background: $surface;
    color: $dim;
    border-color: $border;
}
QPlainTextEdit, QTextEdit {
    background: $surface2;
    color: $text;
    border: 1px solid $input_border;
    border-radius: 6px;
    selection-background-color: $accent_bg;
}
QPlainTextEdit:focus, QTextEdit:focus { border-color: $accent; }

QComboBox {
    background: $surface2;
    color: $text;
    border: 1px solid $input_border;
    border-radius: 6px;
    padding: 3px 8px;
    min-height: 20px;
    /* Force Qt's own list popup instead of the native macOS NSMenu, which
     * ignores every QSS rule below (square corners, native selection). With
     * this the popup is a styleable QAbstractItemView. */
    combobox-popup: 0;
}
QComboBox:hover { border-color: $accent_border; }
QComboBox:focus, QComboBox:on { border-color: $accent; }
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right center;
    border: none;
    width: 20px;
}
QComboBox::down-arrow {
    image: $icon_chevron_down;
    width: 12px; height: 12px;
    margin-right: 4px;
}
QComboBox::down-arrow:hover, QComboBox::down-arrow:on { image: $icon_chevron_down_hover; }
QComboBox QAbstractItemView {
    background: $surface2;
    color: $text;
    border: 1px solid $border;
    border-radius: 8px;
    padding: 4px;
    outline: 0;
    selection-background-color: $accent_bg;
    selection-color: $accent;
}
QComboBox QAbstractItemView::item {
    padding: 5px 10px;
    border-radius: 5px;
    min-height: 18px;
}
QComboBox QAbstractItemView::item:selected { background: $accent_bg; color: $accent; }
/* The popup container window (made frameless + translucent by
 * gui/combo_popup.py) - transparent so only the rounded view above shows. */
#combo-popup { background: transparent; border: none; }

/* ---------- Buttons with no name of their own ----------
 * Dialog buttons (Save, Cancel, Restore Defaults) and the plain buttons of
 * forms. Fusion drew them as bevelled grey boxes that matched nothing else.
 * A named button keeps its own rule (an id selector wins). The default
 * button of a dialog is the accent. */
QPushButton {
    background: $surface3;
    color: $text;
    border: 1px solid $border;
    border-radius: 6px;
    padding: 4px 12px;
    min-height: 18px;
}
QPushButton:hover { border-color: $input_border; }
QPushButton:pressed { background: $surface2; }
QPushButton:focus { border-color: $accent; }
QPushButton:checked { background: $accent_bg; color: $accent; border-color: $accent_border; }
QPushButton:disabled { color: $muted; background: $surface; border-color: $border; }
QPushButton:default {
    background: $accent;
    color: $primary_btn_text;
    border: 1px solid $accent;
    font-weight: 600;
}
QPushButton::menu-indicator {
    image: $icon_chevron_down;
    subcontrol-origin: padding;
    subcontrol-position: right center;
    right: 6px;
    width: 10px; height: 10px;
}

QSpinBox, QDoubleSpinBox {
    background: $surface2;
    color: $text;
    border: 1px solid $input_border;
    border-radius: 6px;
    padding: 3px 6px;
    min-height: 20px;
    selection-background-color: $accent_bg;
    selection-color: $text;
}
QSpinBox:hover, QDoubleSpinBox:hover { border-color: $accent_border; }
QSpinBox:focus, QDoubleSpinBox:focus { border-color: $accent; }
QSpinBox:disabled, QDoubleSpinBox:disabled { color: $muted; background: $surface; border-color: $border; }
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    width: 16px;
    border: none;
    background: transparent;
}
QSpinBox::up-button, QDoubleSpinBox::up-button { subcontrol-position: top right; margin: 2px 2px 0 0; }
QSpinBox::down-button, QDoubleSpinBox::down-button { subcontrol-position: bottom right; margin: 0 2px 2px 0; }
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover { background: $surface3; border-radius: 3px; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: $icon_chevron_up; width: 10px; height: 10px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: $icon_chevron_down; width: 10px; height: 10px; }

QGroupBox {
    background: $surface;
    border: 1px solid $border;
    border-radius: 8px;
    margin-top: 18px;
    padding: 12px 10px 8px 10px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 2px;
    padding: 0 2px 4px 2px;
    color: $text;
    font-weight: 600;
}

/* A menu nobody named (a context menu from Qt itself, a line edit's):
 * the same colours as the rounded ones, square-cornered by necessity. */
QMenu {
    background: $surface;
    color: $text;
    border: 1px solid $border;
    padding: 4px;
}
QMenu::item { padding: 6px 14px; border-radius: 4px; }
QMenu::item:selected { background: $accent_bg; color: $accent; }
QMenu::item:disabled { color: $muted; }
QMenu::separator { height: 1px; background: $border; margin: 4px 8px; }

/* ---------- Top header (above toolbar) ---------- */
QFrame#top-header {
    background: $bg;
    border: none;
}
QLabel#brand-name {
    color: $text;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.01em;
}
QLabel#brand-tag {
    color: $dim;
    font-size: 10px;
    background: $surface3;
    border: 1px solid $border;
    border-radius: 8px;
    padding: 1px 7px;
}
/* The three views: a segmented control, the chosen one raised in its track. */
QFrame#nav-track {
    background: $surface;
    border: 1px solid $border;
    border-radius: 9px;
}
QPushButton#view-pill {
    background: transparent;
    color: $dim;
    border: 1px solid transparent;
    padding: 4px 16px;
    border-radius: 7px;
    font-size: 12px;
    font-weight: 500;
    min-width: 72px;
}
QPushButton#view-pill:hover { color: $text; }
QPushButton#view-pill:checked {
    background: $surface3;
    color: $text;
    border: 1px solid $border;
    font-weight: 600;
}
/* The same, made small for a panel's 30 px title bar (Table | Overview):
 * widgets/primitives.Segmented. A groove in the card, the chosen segment
 * raised and neutral. */
QFrame#seg-track {
    background: $bg;
    border: 1px solid $border;
    border-radius: 7px;
}
QPushButton#seg-pill {
    background: transparent;
    color: $dim;
    border: 1px solid transparent;
    padding: 1px 12px;
    border-radius: 5px;
    font-size: 11px;
    font-weight: 500;
    min-height: 0px;
}
QPushButton#seg-pill:hover { color: $text; }
QPushButton#seg-pill[iconOnly="true"] { padding: 1px 6px; }
QPushButton#seg-pill:checked {
    background: $surface3;
    color: $text;
    border: 1px solid $border;
    font-weight: 600;
}
QPushButton#theme-toggle {
    background: transparent;
    border: 1px solid transparent;
    color: $text;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 14px;
}
QPushButton#theme-toggle:hover { background: $surface3; border-color: $border; }
QPushButton#theme-toggle:pressed { background: $surface2; }

/* ---------- Project switcher (header, PyCharm-style) ---------- */
/* Blue (accent) "current project" anchor; same size + shape as the view
 * pills (matches the checked-pill look), works in both themes. Content is
 * centred with symmetric padding; the right side leaves room for the caret. */
QPushButton#project-switcher {
    background: $surface;
    color: $text;
    border: 1px solid $border;
    border-radius: 9px;
    padding: 6px 24px 6px 12px;
    font-size: 12px;
    font-weight: 600;
    text-align: center;
}
QPushButton#project-switcher:hover { border-color: $input_border; background: $surface3; }
QPushButton#project-switcher::menu-indicator {
    subcontrol-position: right center;
    subcontrol-origin: padding;
    right: 7px;
    width: 10px;
}
/* Rounded dropdown (combined with the frameless + translucent window the
 * header sets on this menu so the corners render cleanly). */
QMenu#project-menu {
    background: $surface;
    border: 1px solid $border;
    border-radius: 8px;
    padding: 6px;
}
QMenu#project-menu::separator { height: 1px; background: $border; margin: 4px 8px; }
QMenu#project-menu::item {
    padding: 7px 12px;
    border-radius: 5px;
    color: $text;
}
QMenu#project-menu::item:selected { background: $accent_bg; color: $accent; }
QLabel#proj-menu-name { color: $accent; font-size: 12px; font-weight: 600; }
QLabel#proj-menu-path { color: $dim; font-size: 10px; }
QLabel#proj-menu-section {
    color: $dim; font-size: 10px; font-weight: 700;
    padding: 6px 12px 2px 12px;
}
QWidget#proj-menu-row { background: transparent; border-radius: 5px; }
QWidget#proj-menu-row:hover { background: $accent_bg; }
QWidget#proj-menu-row-current { background: $surface3; border-radius: 5px; }
QWidget#proj-menu-row-current:hover { background: $accent_bg; }
QLabel#proj-menu-name, QLabel#proj-menu-path { background: transparent; }

/* Generic rounded context / popup menu (combo_popup.round_menu), e.g. the
 * Welcome recents right-click menu. Same look as the project dropdown. */
QMenu#rounded-menu {
    background: $surface;
    border: 1px solid $border;
    border-radius: 8px;
    padding: 6px;
}
QMenu#rounded-menu::separator { height: 1px; background: $border; margin: 4px 8px; }
QMenu#rounded-menu::item {
    padding: 7px 12px;
    border-radius: 5px;
    color: $text;
}
QMenu#rounded-menu::item:selected { background: $accent_bg; color: $accent; }
QMenu#rounded-menu::item:disabled { color: $muted; }
/* A heading inside a menu (the theme menu's groups). */
QLabel#menu-section {
    color: $dim;
    background: transparent;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.8px;
    padding: 8px 12px 3px 12px;
}

/* An explanation opened from an info icon (gui/viz/panels/explain_popup):
 * running text inside a rounded menu, in the menu's own colours. */
QFrame#viz-explain { background: transparent; }
QLabel#viz-explain-text { color: $text; font-size: 12px; background: transparent; }
QScrollArea#viz-explain-scroll { background: transparent; border: none; }

/* ---------- Toolbar ---------- */
QFrame#toolbar {
    background: $bg;
    border: none;
}

QPushButton#tb-btn {
    background: $surface3;
    border: 1px solid $border;
    color: $text;
    padding: 4px 11px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 500;
}
QPushButton#tb-btn:hover  { border-color: $input_border; }
QPushButton#tb-btn:pressed { background: $surface2; }
QPushButton#tb-btn:disabled { color: $muted; background: $surface; border-color: $border; }
/* In a toolbar the buttons are quiet: no box until hovered, so the one
 * primary action and the state chips are what the eye finds. */
QFrame#toolbar QPushButton#tb-btn,
QFrame#sidecar-toolbar QPushButton#tb-btn {
    background: transparent;
    border: 1px solid transparent;
}
QFrame#toolbar QPushButton#tb-btn:hover,
QFrame#sidecar-toolbar QPushButton#tb-btn:hover {
    background: $surface3;
    border-color: $border;
}
QFrame#toolbar QPushButton#tb-btn:pressed,
QFrame#sidecar-toolbar QPushButton#tb-btn:pressed { background: $surface2; }
QFrame#toolbar QPushButton#tb-btn:disabled,
QFrame#sidecar-toolbar QPushButton#tb-btn:disabled {
    background: transparent; border-color: transparent; color: $muted;
}

QPushButton#tb-btn-ghost {
    background: transparent;
    border: 1px solid transparent;
    color: $dim;
    padding: 4px 9px;
    border-radius: 6px;
    font-size: 11px;
}
QPushButton#tb-btn-ghost:hover { color: $text; background: $surface3; }

QPushButton#tb-btn-primary {
    background: $accent;
    border: 1px solid $accent;
    color: $primary_btn_text;
    padding: 4px 14px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 600;
}
QPushButton#tb-btn-primary:hover { border-color: $text; }
QPushButton#tb-btn-primary:disabled { background: $surface3; border-color: $border; color: $muted; }

/* Toggle-style toolbar button (e.g. "Highlight repeats"). Switches
 * to the purple palette when checked so the user knows the overlay
 * is active. */
QPushButton#tb-btn-toggle {
    background: transparent;
    border: 1px solid $border;
    color: $dim;
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 11px;
}
QPushButton#tb-btn-toggle:hover { color: $text; background: $surface3; }
QPushButton#tb-btn-toggle:checked {
    background: $accent_bg;
    border-color: $accent_border;
    color: $accent;
}

/* Tiny "TSV:" / "dataset:" label sitting before an input in the toolbar. */
QLabel#tb-mini-label {
    color: $dim;
    font-size: 11px;
}

/* Toolbar input fields (TSV filename, etc.). Compact, palette-driven. */
QLineEdit#tb-input {
    background: $surface2;
    color: $text;
    border: 1px solid $input_border;
    border-radius: 6px;
    padding: 2px 6px;
    font-size: 11px;
    selection-background-color: $accent;
    selection-color: $primary_btn_text;
}
QLineEdit#tb-input:focus { border-color: $accent; }

QFrame#vsep {
    background: $border;
    max-width: 1px;
    min-width: 1px;
    margin: 4px 4px;
}

/* ---------- Status chips ---------- */
/* border-radius is large so Qt clamps it to half the height -> a perfect
 * pill at ANY font scale (a fixed 9px looked square once the font/height
 * changed). A border is required so the background clips to the radius. */
QLabel[chipKind] {
    padding: 1px 9px;
    border-radius: 100px;
    font-size: 11px;
    font-weight: 500;
    background: $surface3;
    border: 1px solid $border;
    color: $dim;
}
QLabel[chipKind="success"] {
    background: $success_bg;
    color: $success;
    border: 1px solid $success_border;
}
QLabel[chipKind="warn"] {
    background: $warning_bg;
    color: $warning;
    border: 1px solid $warning_border;
}
QLabel[chipKind="err"] {
    background: $error_bg;
    color: $error;
    border: 1px solid $error_border;
}
QLabel[chipKind="accent"] {
    background: $accent_bg;
    color: $accent;
    border: 1px solid $accent_border;
}
QLabel[chipKind="purple"] {
    background: $purple_bg;
    color: $purple;
    border: 1px solid $purple_border;
}
QLabel[chipKind="teal"] {
    background: $teal_bg;
    color: $teal;
    border: 1px solid $teal_border;
}

/* ---------- Path bars ---------- */
QFrame#pathbar {
    background: $bg;
    border: none;
}
QLabel#path-label {
    color: $dim;
    font-size: 11px;
}
QLineEdit#path-field {
    background: $surface;
    border: 1px solid $border;
    border-radius: 8px;
    color: $text;
    padding: 4px 10px;
    font-size: 11px;
}
QLineEdit#path-field:focus { border-color: $accent; }

/* ---------- Pane headers ---------- */
QLabel#pane-h5 {
    background: $surface;
    color: $dim;
    padding: 7px 12px;
    border-bottom: 1px solid $subtle;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.8px;
}

/* Placeholder / hint labels used in empty panes and stub tabs. They
 * follow the dim palette token so dark↔light toggle refreshes them.
 *
 * The generous padding is deliberate and belongs to the EMPTY-PANE case:
 * a "nothing selected" message centred in a large blank area. It is wrong
 * for a status line inside a dialog, where 24px top and bottom pushes the
 * sections apart; that is what #dlg-hint below is for. */
QLabel#pane-hint {
    color: $dim;
    padding: 24px;
    font-size: 11px;
}

/* The same quiet voice, sized for a line of running text: an explanation
 * under a section heading, or a status line in a dialog footer. */
QLabel#dlg-hint {
    color: $dim;
    font-size: 11px;
}

/* Settings > Viewer shortcuts: the line that reports keys used twice. */
QLabel#viz-conflicts {
    color: $dim;
    font-size: 11px;
}
QLabel#viz-conflicts[state="error"] {
    color: $error;
}

/* The caption above each image of a side-by-side comparison. */
QLabel#section-caption {
    color: $text;
    font-size: 12px;
    font-weight: 600;
    padding: 2px 2px;
}

/* ---------- Cards ----------
 * A panel at the top of a layout is a CARD on the window's canvas
 * (PanelFrame.make_card): rounded, outlined, a gap to its neighbours (the
 * handles of the ``card-split`` splitters). What is inside draws nothing
 * of its own background, so the card is one surface; panels nested inside
 * a card stay flat and are divided by hairlines. */
QWidget#card-canvas { background: transparent; }
QFrame[card="true"] {
    background: $surface;
    border: 1px solid $border;
    border-radius: 10px;
}
QFrame[card="true"] QFrame#panel-frame-header { background: transparent; }
QWidget#panel-frame-strip { background: transparent; border: none; }
/* A top or bottom panel's title bar folds it: a hover says so. */
QFrame#panel-frame-header[foldable="true"]:hover { background: $surface3; }
QFrame[card="true"] QWidget#pane,
QFrame[card="true"] QWidget#pane-dark { background: transparent; border: none; }
QFrame[card="true"] QLabel#pane-h5 { background: transparent; }
/* A list, a tree or a log inside a card is the card: no second box. */
QFrame[card="true"] QTreeWidget#log-history,
QFrame[card="true"] QTreeWidget#renumber-table {
    background: transparent;
    border: none;
}
/* Splitter handles paint themselves (widgets/splitter.Splitter): a three-dot
 * grip, and the accent wash under the mouse. */

/* Collapsible / detachable panel-frame header bar. Mirrors the pane-h5
 * look (surface background + bottom rule) but carries a collapse caret on
 * the left and a detach button on the right. The title label inside drops
 * its own background / border so the bar reads as one strip. */
QFrame#panel-frame-header {
    background: $surface;
    border-bottom: 1px solid $subtle;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}
QFrame#panel-frame-header QLabel#pane-h5 {
    background: transparent;
    border-bottom: none;
    padding: 0px 2px;
}
QToolButton#panel-frame-caret,
QToolButton#dock-corner-btn,
QToolButton#panel-frame-detach {
    background: transparent;
    border: none;
    padding: 2px;
}
QToolButton#panel-frame-caret:hover,
QToolButton#dock-corner-btn:hover,
QToolButton#panel-frame-detach:hover {
    background: $border;
    border-radius: 3px;
}

/* A toggle among a panel's corner icons (Filter's Hide rows left out):
 * when on it carries the accent's wash, as a toggle that is ON does. */
QToolButton#dock-corner-btn:checked {
    background: $accent_bg;
    border-radius: 3px;
}

/* ---------- Inspection > Overview (gui/overview_pane.py) ----------
 * Inside the Inspection card: flat, divided by hairlines, no boxes. The
 * grid's cells and headers are painted from the palette. */
QScrollArea#overview-scroll,
QWidget#overview-body { background: transparent; border: none; }
QFrame#overview-rule { background: $subtle; border: none; }
QLabel#overview-finding { color: $text; font-size: 12px; }
/* A section title that folds its section (Worth a look): the section-title
 * voice, with the chevron the panels fold with. */
QToolButton#overview-fold {
    color: $muted;
    background: transparent;
    border: none;
    padding: 0px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
}
QToolButton#overview-fold:hover { color: $text; }
QPushButton#inline-link {
    color: $accent;
    background: transparent;
    border: none;
    padding: 0px 2px;
    font-size: 11px;
    font-weight: 600;
    min-height: 0px;
}
QPushButton#inline-link:hover { text-decoration: underline; }
QTableView#overview-grid {
    background: transparent;
    border: none;
    outline: none;
}
QHeaderView#overview-header,
QHeaderView#overview-header::section {
    background: transparent;
    border: none;
}

/* ---------- Filter > BIDS preview (gui/output_preview.py) ---------- */
QTreeWidget#plan-tree { background: transparent; border: none; }
QWidget#plan-file { background: transparent; }
QLabel#plan-file-name { color: $text; font-size: 12px; font-weight: 600; }
QTextBrowser#plan-preview {
    background: $bg;
    color: $text;
    border: 1px solid $border;
    border-radius: 6px;
    padding: 6px 8px;
    font-family: "JetBrains Mono";
    font-size: 11px;
    selection-background-color: $accent_bg;
}

/* Bottom-dock log view. Uses a slightly tinted background so the
 * worker output reads clearly against both palettes. Selection inherits
 * the accent token (already covered by ``QPalette.Highlight``). */
QPlainTextEdit#dock-log {
    background: transparent;
    color: $text;
    border: none;
    font-family: "JetBrains Mono";
    font-size: 11px;
    selection-background-color: $accent;
    selection-color: $primary_btn_text;
}

/* ------------------------------------------------------------------
 * Issues dialog (clicked from the toolbar chips)
 * ------------------------------------------------------------------ */
QDialog { background: $bg; }

QFrame#issue-dialog-header {
    background: $surface;
    border-bottom: 1px solid $border;
}
QLabel#issue-dialog-title {
    color: $text;
    font-size: 14px;
    font-weight: 600;
}
QLabel#issue-dialog-subtitle {
    color: $dim;
    font-size: 11px;
}
QScrollArea#issue-dialog-scroll, QWidget#issue-dialog-body { background: $bg; }
QFrame#issue-dialog-footer {
    background: $surface;
    border-top: 1px solid $border;
}

/* One row's card: row identifier + stacked ValMessages. */
QFrame#issue-card {
    background: $surface;
    border: 1px solid $border;
    border-radius: 8px;
}
QPushButton#issue-card-title {
    color: $accent;
    background: transparent;
    border: none;
    text-align: left;
    padding: 0;
    font-size: 12px;
    font-weight: 600;
}
QPushButton#issue-card-title:hover { text-decoration: underline; }
QLabel#issue-card-jump-hint {
    color: $dim;
    font-size: 10px;
}

QWidget#pane {
    background: $surface;
    border-right: 1px solid $border;
}
QWidget#pane-dark {
    background: $bg;
    border-right: 1px solid $border;
}

/* ---------- Splitter handles ---------- */
/* Only a splitter that is not a widgets/splitter.Splitter reaches these. */
QSplitter::handle:horizontal { background: $subtle; width: 1px; }
QSplitter::handle:vertical   { background: $subtle; height: 1px; }
QSplitter::handle:hover      { background: $accent; }

/* ---------- Tree widgets ---------- */
QTreeWidget {
    background: transparent;
    border: none;
    color: $text;
    show-decoration-selected: 1;
    outline: 0;
    font-size: 11px;
}
QTreeWidget::item {
    padding: 2px 4px;
    min-height: 20px;
    border: none;
}
QTreeWidget::item:hover    { background: $surface3; }
QTreeWidget::item:selected {
    background: $accent_bg;
    color: $accent;
}
QTreeView::branch:closed:has-children { image: $icon_chevron_right; }
QTreeView::branch:open:has-children { image: $icon_chevron_down; }

QTreeWidget#filter-tree {
    font-size: 11px;
}

QTreeWidget#raw-tree::item { padding-left: 0px; }

/* ---------- Inspection table ---------- */
QTableView#inv-table {
    background: transparent;
    alternate-background-color: transparent;
    color: $text;
    border: none;
    gridline-color: $subtle;
    selection-background-color: $accent_bg;
    selection-color: $text;
    font-size: 11px;
}
QTableView#inv-table::item {
    padding: 5px 8px;
    border-bottom: 1px solid $subtle;
    border-right: none;
    font-size: 11px;
}
QTableView#inv-table::item:selected { background: $accent_bg; }

/* Editor TSV viewer (read-only) — same chrome as the converter's
   inspection table so the theme follows automatically. */
QTableView#tsv-view {
    background: transparent;
    alternate-background-color: $surface2;
    color: $text;
    border: none;
    gridline-color: $subtle;
    selection-background-color: $accent_bg;
    selection-color: $text;
    font-size: 11px;
}
QTableView#tsv-view::item {
    padding: 4px 8px;
    border-bottom: 1px solid $subtle;
}
QTableView#tsv-view::item:selected { background: $accent_bg; }

/* DICOM header pane: a tree of modules and elements, the frames and a
   comparison as tables. No item colour here: identifying values and tags
   are coloured by the model (ForegroundRole), which an ::item color would
   override. */
QTreeView#dicom-header-tree,
QTableView#dicom-frames,
QTableView#dicom-compare {
    background: transparent;
    alternate-background-color: transparent;
    border: none;
    outline: 0;
    color: $text;
    selection-background-color: $accent_bg;
    selection-color: $text;
    font-size: 11px;
}
QTreeView#dicom-header-tree::item {
    padding: 3px 4px;
    min-height: 20px;
    border: none;
}
QTreeView#dicom-header-tree::item:hover { background: $surface3; }
QTreeView#dicom-header-tree::item:selected { background: $accent_bg; }
QTableView#dicom-frames::item,
QTableView#dicom-compare::item {
    padding: 4px 8px;
    border-bottom: 1px solid $subtle;
}
QTableView#dicom-frames::item:selected,
QTableView#dicom-compare::item:selected { background: $accent_bg; }
QFrame#dicom-rule { background: $subtle; border: none; }
/* Settings > Convert > Source data: what keeping it means. */
QLabel#sourcedata-note { color: $warning; font-size: 11px; background: transparent; }
QLabel#sourcedata-note:disabled { color: $dim; }
QLabel#dicom-fact {
    color: $dim;
    font-size: 11px;
    background: transparent;
}
QLabel#dicom-fact-strong {
    color: $text;
    font-size: 11px;
    font-weight: 600;
    background: transparent;
}

QHeaderView { background: transparent; }
QHeaderView::section {
    background: transparent;
    color: $dim;
    padding: 7px 8px;
    border: none;
    border-bottom: 1px solid $border;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.6px;
    text-transform: uppercase;
}
QHeaderView::section:hover { color: $text; }

QTableCornerButton::section {
    background: transparent;
    border: none;
    border-bottom: 1px solid $border;
}

/* ---------- Properties panel (entity editor) ---------- */
QWidget#props-panel { background: $surface; }

QLabel#section-title {
    color: $muted;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 0;
}
QLabel#section-title-bold {
    color: $text;
    font-size: 12px;
    font-weight: 600;
    padding: 0;
}
QLabel#field-label,
QLabel#field-label-req {
    color: $dim;
    font-size: 11px;
}
QLabel#field-label-opt {
    color: $muted;
    font-size: 11px;
}

QLineEdit#ent-input,
QComboBox#ent-input {
    background: $surface2;
    border: 1px solid $border;
    border-radius: 3px;
    color: $text;
    padding: 3px 8px;
    font-size: 11px;
    min-height: 20px;
}
QLineEdit#ent-input:focus,
QComboBox#ent-input:focus {
    border-color: $accent;
}

QComboBox#ent-input::drop-down { border: none; width: 18px; }
QComboBox#ent-input::down-arrow {
    image: $icon_chevron_down;
    width: 11px; height: 11px;
    margin-right: 4px;
}
QComboBox#ent-input QAbstractItemView {
    background: $surface2;
    color: $text;
    border: 1px solid $border;
    selection-background-color: $accent_bg;
    outline: 0;
}

QFrame#path-preview {
    background: $surface2;
    border: 1px solid $border;
    border-radius: 4px;
    padding: 8px 11px;
}
QLabel#path-preview-text {
    font-size: 11px;
    color: $text;
}

QFrame#why-panel {
    background: $surface2;
    border: 1px solid $subtle;
    border-radius: 4px;
    padding: 9px 11px;
}
QLabel#why-h5 {
    color: $muted;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
}

/* ---------- Bottom dock (tabbed) ---------- */
QTabWidget::pane {
    background: transparent;
    border: none;
    border-top: 1px solid $subtle;
}
QTabBar {
    background: transparent;
    border: none;
}
QTabBar::tab {
    background: transparent;
    color: $dim;
    padding: 7px 14px;
    border: none;
    border-bottom: 2px solid transparent;
    margin-right: 4px;
    font-size: 12px;
}
QTabBar::tab:selected {
    color: $text;
    border-bottom: 2px solid $accent;
    background: transparent;
}
QTabBar::tab:hover:!selected { color: $text; }

/* ---------- Status bar ---------- */
QStatusBar {
    background: $bg;
    color: $dim;
    border: none;
    padding: 0 14px;
    font-size: 11px;
    min-height: 26px;
}
QStatusBar::item { border: none; }
QLabel#status-pill {
    background: $success_bg;
    color: $success;
    padding: 1px 9px;
    border-radius: 9px;
    font-size: 11px;
    font-weight: 500;
}
QLabel#update-version-label {
    color: $dim;
    font-size: 11px;
    padding: 0 6px;
}
QPushButton#update-check-btn {
    background: transparent;
    color: $accent;
    border: none;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 500;
}
QPushButton#update-check-btn:hover {
    background: $surface3;
    color: $text;
}
QPushButton#update-check-btn:disabled {
    color: $muted;
}

/* ---------- Editor: file tab strip ---------- */
QFrame#file-tabs {
    background: $surface2;
    border-bottom: 1px solid $border;
    padding: 0;
}
QPushButton#file-tab {
    background: transparent;
    color: $dim;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 7px 13px;
    font-size: 11px;
}
QPushButton#file-tab:hover { color: $text; }
QPushButton#file-tab:checked {
    color: $text;
    border-bottom: 2px solid $accent;
}

/* ---------- Editor: schema legend ---------- */
QFrame#schema-legend {
    background: $surface2;
    border-bottom: 1px solid $subtle;
    padding: 6px 14px;
}
QLabel#legend-text {
    color: $dim;
    font-size: 10px;
}

/* ---------- Editor: sidecar form rows ---------- */
QFrame#sc-row { background: transparent; }
QFrame#sc-row:hover { background: $surface; }
QLabel#sc-key  { color: $text; font-size: 11px; }
QLabel#sc-key-dep  { color: $muted; font-size: 11px; }
QLabel#sc-val-str { color: $accent; font-size: 11px; }
QLabel#sc-val-num { color: $purple; font-size: 11px; }
QLabel#sc-val-todo { color: $error; font-size: 11px; font-style: italic; }

/* SidecarRow 4px level bar — colors come from the palette tokens so a
   theme swap is just an app-wide QSS re-apply, exactly like
   ``#dock-log``. No per-widget repaint listener needed. */
QFrame#sc-bar-req { background: $error; }
QFrame#sc-bar-rec { background: $warning; }
QFrame#sc-bar-opt { background: $muted_40; }
QFrame#sc-bar-dep { background: $muted; }

/* Schema-legend swatches — same QSS-only pattern. */
QFrame#legend-swatch-req { background: $error;    border-radius: 2px; }
QFrame#legend-swatch-rec { background: $warning;  border-radius: 2px; }
QFrame#legend-swatch-opt { background: $muted_40; border-radius: 2px; }
QFrame#legend-swatch-dep { background: $muted;    border-radius: 2px; }

/* SidecarFormPane edit toolbar (Save / Revert + dirty chip). */
QFrame#sidecar-toolbar {
    background: transparent;
    border-bottom: 1px solid $subtle;
}
QLabel#sidecar-dirty-chip {
    background: $warning_bg;
    color: $warning;
    border: 1px solid $warning_border;
    border-radius: 8px;
    padding: 1px 8px;
    font-size: 10px;
    font-weight: 600;
}

/* SidecarFormPane status footer. */
QFrame#sidecar-footer {
    background: $surface2;
    border-top: 1px solid $subtle;
}

/* Footer strip at the bottom of the Converter's Inspection pane,
   holding the per-pane Highlight aborts + Bulk edit buttons. Same
   chrome as the sidecar footer so the theme follows. */
QFrame#inspection-footer {
    background: $surface2;
    border-top: 1px solid $subtle;
}

/* About / Authorship dialog. */
QDialog#about-dialog {
    background: $bg;
}
QScrollArea#about-scroll { background: $bg; border: none; }
QWidget#about-body { background: $bg; }
QLabel#about-title {
    color: $text;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.01em;
}
QLabel#about-version {
    color: $dim;
    font-size: 12px;
}
QLabel#about-intro {
    color: $text;
    font-size: 13px;
}
QLabel#about-lab-desc {
    color: $dim;
    font-size: 12px;
}
QLabel#about-section-header {
    color: $accent;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}
QFrame#about-divider {
    background: $subtle;
    max-height: 1px;
    border: none;
}
QFrame#about-author-row { background: transparent; }
QLabel#about-author-pic {
    border: 1px solid $border;
    border-radius: 6px;
    padding: 2px;
}
QLabel#about-author-bio {
    color: $text;
    font-size: 12px;
}
QLabel#about-ack {
    color: $dim;
    font-size: 12px;
    line-height: 1.6em;
}
QLabel#about-links {
    color: $accent;
    font-size: 11px;
}
QFrame#about-footer {
    background: $surface2;
    border-top: 1px solid $subtle;
}

/* What's new: shown once per release (gui/whats_new.py). The animation is
 * painted on the dialog's own background; the text sits beside it. */
QDialog#whatsnew-dialog { background: $bg; }
QLabel#whatsnew-kicker {
    color: $dim;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
}
QLabel#whatsnew-title {
    color: $text;
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.01em;
}
QLabel#whatsnew-lede {
    color: $text;
    font-size: 14px;
}
QLabel#whatsnew-item-title {
    color: $text;
    font-size: 13px;
    font-weight: 600;
}
QLabel#whatsnew-item {
    color: $dim;
    font-size: 12px;
}
QFrame#whatsnew-footer {
    background: $surface2;
    border-top: 1px solid $subtle;
}
QLabel#sidecar-footer-path {
    color: $dim;
    font-size: 10px;
}
QLabel#sidecar-footer-summary {
    color: $dim;
    font-size: 10px;
}
/* Anatomical orientation markers (L/R·A/P·S/I) around each NIfTI slice. */
QLabel#nifti-orient-label {
    color: $accent;
    font-size: 13px;
    font-weight: 600;
}

/* ---------- Editor: EEG/MEG recording viewer ---------- */
/* Metadata card: a scrollable list of label/value rows shown before the
 * user loads the signal. All colours come from palette tokens so the
 * card follows the dark/light theme. */
QScrollArea#viewer-meta-scroll { background: $bg; border: none; }
QLabel#viewer-meta-title {
    color: $text;
    font-size: 16px;
    font-weight: 700;
    padding-bottom: 4px;
}
QLabel#viewer-meta-section {
    color: $accent;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding-top: 10px;
}
QWidget#viewer-meta-row { background: transparent; }
QLabel#viewer-meta-key {
    color: $dim;
    font-size: 12px;
}
QLabel#viewer-meta-val {
    color: $text;
    font-size: 12px;
}
QLabel#viewer-meta-note {
    color: $teal;
    font-size: 11px;
    padding-top: 4px;
}
/* Collapsible section header inside the time-series viewer (Display
 * controls / Events). Flat, full-width, with a hover wash. */
QPushButton#viewer-section-toggle {
    background: $surface2;
    color: $dim;
    border: none;
    border-bottom: 1px solid $subtle;
    padding: 5px 12px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
    text-align: left;
}
QPushButton#viewer-section-toggle:hover { color: $text; background: $surface3; }
QPushButton#viewer-section-toggle:checked { color: $text; }
/* The fixed-width channel-label strip beside the plot + the horizontal
 * toolbar scroll (lets the viewer shrink without the toolbar forcing width). */
QScrollArea#viewer-toolbar-scroll { background: transparent; border: none; }

/* "Load signal" button on the metadata card - styled like the header project
 * switcher (accent pill, rounded, centered), not a green action button. */
QPushButton#load-signal-btn {
    background: $accent_bg;
    color: $accent;
    border: 1px solid $accent_border;
    border-radius: 5px;
    padding: 7px 30px;
    font-size: 12px;
    font-weight: 600;
}
QPushButton#load-signal-btn:hover { background: $accent_border; color: $text; }
QPushButton#load-signal-btn:pressed { background: $accent_bg; }

/* The toolbar-sized version of the same idea. "Visualize" sits in a row of
 * buttons that all edit the table (add a row, delete a column, save) and it
 * does something categorically different: it leaves the table and opens
 * another view of the same file. Styled as the accent action it is, and
 * sized to the bar so it does not make the row taller.
 *
 * Checked, not just hovered, because it is a toggle: while the viewer is
 * open the button has to read as pressed, or the only way back to the table
 * is guessing. */
QPushButton#primary-btn {
    background: $accent_bg;
    color: $accent;
    border: 1px solid $accent_border;
    border-radius: 4px;
    padding: 4px 13px;
    font-size: 11px;
    font-weight: 600;
}
QPushButton#primary-btn:hover { background: $accent_border; color: $text; }
QPushButton#primary-btn:pressed,
QPushButton#primary-btn:checked {
    background: $accent;
    color: $primary_btn_text;
    border: 1px solid $accent;
}
QPushButton#primary-btn:disabled { color: $muted; border-color: $border; background: transparent; }

/* ---------- Editor: validation panel ---------- */
QWidget#val-panel { background: $surface; }
QLabel#val-section-title {
    color: $muted;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
}
/* Schema-audit rows inside the Validation pane. */
QLabel#val-audit-summary {
    color: $text;
    font-size: 11px;
}
QLabel#val-audit-missing {
    color: $error;
    font-size: 10px;
}

/* Validation-pane section count chips are now painted Chip widgets
 * (widgets/primitives.Chip) - always-pill, theme-aware - so no QSS here. */

QFrame#val-msg {
    background: $surface2;
    border: 1px solid $subtle;
    border-radius: 4px;
    padding: 7px 10px;
}
QFrame#val-msg-ok {
    background: $success_bg;
    border: 1px solid $success_border;
    border-radius: 4px;
    padding: 7px 10px;
}
QFrame#val-msg-warn {
    background: $warning_bg;
    border: 1px solid $warning_border;
    border-radius: 4px;
    padding: 7px 10px;
}
QFrame#val-msg-err {
    background: $error_bg;
    border: 1px solid $error_border;
    border-radius: 4px;
    padding: 7px 10px;
}
QLabel#val-rule {
    font-family: "JetBrains Mono";
    font-size: 9px;
    color: $muted;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}
/* Provenance: the schema path a finding came from, shown under the body so a
   user can check the standard. Quieter than the rule code above it, and not
   uppercased, because it is a path to be read literally. */
QLabel#val-provenance {
    font-family: "JetBrains Mono";
    font-size: 9px;
    color: $muted;
    background: transparent;
}

/* Optional small chip on the header row, naming the JSON field a
   finding refers to (e.g. "License" for a TODO-placeholder issue). */
QLabel#val-field {
    font-size: 9px;
    color: $accent;
    background: $accent_bg;
    border: 1px solid $accent_border;
    border-radius: 8px;
    padding: 1px 6px;
}
QLabel#val-body  { color: $text; font-size: 11px; }
QPushButton#val-fix, QPushButton#val-highlight-all {
    background: $accent_bg;
    color: $accent;
    border: 1px solid $accent_border;
    border-radius: 3px;
    padding: 1px 7px;
    font-size: 10px;
}
QPushButton#val-fix:hover, QPushButton#val-highlight-all:hover { background: $accent; color: $primary_btn_text; }

/* ---------- Scrollbars ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 11px;
    margin: 2px 2px 2px 0;
}
QScrollBar::handle:vertical {
    background: $border;
    border-radius: 4px;
    min-height: 32px;
    margin: 0 1px;
}
QScrollBar::handle:vertical:hover { background: $muted; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }

QScrollBar:horizontal {
    background: transparent;
    height: 11px;
    margin: 0 2px 2px 2px;
}
QScrollBar::handle:horizontal {
    background: $border;
    border-radius: 4px;
    min-width: 32px;
    margin: 1px 0;
}
QScrollBar::handle:horizontal:hover { background: $muted; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }

/* ------------------------------------------------------------------
 * Busy spinner (toolbar)
 * ------------------------------------------------------------------ */
QWidget#busy-spinner { background: transparent; }
QWidget#busy-spinner-glyph { background: transparent; }
QLabel#busy-spinner-message {
    color: $dim;
    font-size: 11px;
}

/* ------------------------------------------------------------------
 * Welcome (Home) tab - the project-first landing.
 * Every surface keys off a theme token so a dark<->light swap repaints
 * cleanly (combined with WelcomePanel.repaint_for_palette).
 * ------------------------------------------------------------------ */
QWidget#welcome-panel,
QScrollArea#welcome-scroll,
QWidget#welcome-body,
QWidget#welcome-col,
QWidget#welcome-hero { background: $bg; }
QScrollArea#welcome-scroll { border: none; }

QLabel#welcome-title {
    color: $text;
    font-size: 23px;
    font-weight: 700;
}
QLabel#welcome-subtitle {
    color: $dim;
    font-size: 12px;
}

QFrame#welcome-card {
    background: $surface;
    border: 1px solid $border;
    border-radius: 10px;
}
QLabel#welcome-section {
    color: $text;
    font-size: 14px;
    font-weight: 600;
}
QLabel#welcome-section-desc {
    color: $dim;
    font-size: 11px;
}

QLineEdit#welcome-input {
    background: $surface3;
    color: $text;
    border: 1px solid $border;
    border-radius: 6px;
    padding: 6px 9px;
    font-size: 12px;
    selection-background-color: $accent;
    selection-color: $primary_btn_text;
}
QLineEdit#welcome-input:focus { border-color: $accent; }
QLineEdit#welcome-input:read-only { color: $dim; }

/* Open-dataset button: ghost styling but blue (accent) text. */
QPushButton#welcome-open-btn {
    color: $accent;
    background: transparent;
    border: 1px solid $accent_border;
    border-radius: 6px;
    padding: 7px 14px;
    font-size: 12px;
    font-weight: 600;
}
QPushButton#welcome-open-btn:hover {
    background: $accent_bg;
    border-color: $accent;
}

/* "Sample datasets" sub-heading inside the Getting-started card. */
QLabel#welcome-subsection {
    color: $text;
    font-size: 12px;
    font-weight: 600;
    margin-top: 4px;
}

/* Resource / sample-data links. Colour comes from QPalette.Link (accent),
 * set by the theme manager, so it follows dark/light automatically. */
QLabel#welcome-link {
    font-size: 12px;
    padding: 1px 0;
}

QListWidget#welcome-recent {
    background: $surface2;
    color: $text;
    border: 1px solid $border;
    border-radius: 6px;
    padding: 4px;
    font-size: 12px;
}
QListWidget#welcome-recent::item {
    padding: 6px 8px;
    border-radius: 4px;
}
QListWidget#welcome-recent::item:hover { background: $surface3; }
QListWidget#welcome-recent::item:selected {
    background: $accent_bg;
    color: $accent;
}

/* ---------- Settings: pages listed down the left ---------- */
QListWidget#settings-nav {
    background: $surface;
    color: $text;
    border: none;
    border-right: 1px solid $border;
    padding: 10px 8px;
    font-size: 12px;
    outline: 0;
}
QListWidget#settings-nav::item {
    padding: 7px 10px;
    margin: 1px 0;
    border-radius: 6px;
}
QListWidget#settings-nav::item:hover { background: $surface3; }
QListWidget#settings-nav::item:selected {
    background: $accent_bg;
    color: $accent;
}
QStackedWidget#settings-pages, QWidget#settings-page { background: $bg; }
QScrollArea#settings-scroll { background: transparent; border: none; }
QScrollArea#settings-scroll > QWidget > QWidget { background: transparent; }
QLabel#settings-page-title {
    color: $text;
    font-size: 16px;
    font-weight: 600;
}

/* ---------- NIfTI viewer image canvas ----------
 * The visualization area only (2-D slice panels + the 3-D render pages).
 * Pure black so scans read like a lightbox and match the GL clear colour;
 * deliberately NOT #pane-dark, which other panels share. Child pages are
 * plain QWidgets that paint no background, so this shows through. */
QStackedWidget#nifti-canvas,
QWidget#nifti-canvas {
    background: #000000;
    border: none;
}

/* The viewer's controls column: opaque so the black image canvas behind it
 * never shows through (a scroll bar gutter used to read as a black stripe).
 * The viewport is named from Python because a stylesheet can't select it. */
QScrollArea#viz-side-scroll,
QWidget#viz-side-viewport,
QWidget#viz-inspector,
QWidget#viz-section,
QWidget#viz-section-body {
    background: $surface2;
    border: none;
}
/* One section from the next: a hairline, not a box. */
QWidget#viz-section {
    border-bottom: 1px solid $border;
}
/* The number beside every slider: compact, right-aligned, no arrows. */
QDoubleSpinBox#viz-number {
    padding: 2px 6px;
    min-height: 20px;
}
QListWidget#viz-layer-list {
    border-radius: 6px;
}
/* Tracks (QC and physiology under a time axis): a rounded card each, the
 * title and readout in a header ABOVE the plot so neither covers the signal. */
QScrollArea#viz-tracks-scroll,
QWidget#viz-tracks-viewport,
QWidget#viz-tracks-body,
QWidget#viz-tracks {
    background: $surface;
    border: none;
}
QFrame#viz-track {
    background: $surface2;
    border: 1px solid $border;
    border-radius: 8px;
}
QLabel#viz-track-title {
    color: $text;
    font-size: 11px;
    font-weight: 600;
    background: transparent;
}
QLabel#viz-track-readout {
    color: $dim;
    font-size: 11px;
    background: transparent;
}
QPushButton#viz-track-btn {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 0px;
}
QPushButton#viz-track-btn:hover { background: $surface3; }
QPushButton#viz-track-btn:disabled { background: transparent; }
/* A panel's header inside a viewer (time course, QC plots): its controls on
 * the left, its window controls as icons in the upper-right corner. */
QWidget#viz-panel-header {
    background: transparent;
    border: none;
}
QPushButton#viz-corner-btn {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 0px;
}
QPushButton#viz-corner-btn:hover { background: $surface3; border: 1px solid $border; }
QPushButton#viz-corner-btn:checked {
    background: $accent_bg;
    border: 1px solid $accent_border;
}
QPushButton#viz-corner-btn:disabled { background: transparent; }
QPushButton#viz-corner-btn::menu-indicator { image: none; width: 0px; }
/* The header above a set of tracks (a PanelHeader: what to show, how, what
 * to do; the panel's own controls in its corner). */
QWidget#viz-tracks-bar {
    background: $surface;
    border: none;
    border-bottom: 1px solid $border;
}

/* ---------- Editor automation: fix-ups, bulk edit, citation, ignore ----------
   Same QSS-only pattern as the sidecar rows above: every colour is a palette
   token, so a dark/light swap is the app-wide re-apply and no widget needs a
   repaint listener. Anything that cannot be reached this way (an item view's
   per-row foreground) is set in code and re-rendered by the pane's
   ``repaint_for_palette``. */

/* A scroll surface and its content widget need their own background rule:
   a plain QWidget does not inherit the parent's QSS background, and on a
   theme swap it keeps the brush it was first polished with. Same treatment
   as #issue-dialog-scroll / #issue-dialog-body above. */
QScrollArea#cff-scroll, QWidget#cff-body { background: $surface; border: none; }

/* Editor documents (gui/widgets/text_pane, picture_pane, gradient_pane):
 * the text as stored in a monospace face, the rendered view in the app's,
 * both on the pane's surface and sized by the font setting. */
QPlainTextEdit#text-document {
    background: $surface; color: $text; border: none;
    padding: 10px 14px;
    font-family: "JetBrains Mono";
    font-size: 12px;
    selection-background-color: $accent_bg;
}
QTextBrowser#text-rendered {
    background: $bg; color: $text; border: none;
    selection-background-color: $accent_bg;
}
QScrollArea#picture-scroll, QLabel#picture-label { background: $surface; border: none; }
QTableWidget#gradient-table { border: none; }
QPlainTextEdit#ent-input {
    background: $bg; color: $text;
    border: 1px solid $input_border; border-radius: 4px; padding: 3px 6px;
}
QPlainTextEdit#ent-input:focus { border: 1px solid $accent; }

/* The plain-language note under a finding: quieter than the message it
   explains, louder than the schema path below it. */
QLabel#val-explanation { color: $muted; font-size: 11px; }

/* Section heading inside a dialog (Fix ups). */
QLabel#dlg-section-title { color: $text; font-weight: 600; }

/* A row the action does not apply to, in the bulk-edit candidate list. */
QCheckBox#candidate-off { color: $muted; }

/* CITATION.cff form: the field name, coloured by what the format asks of it,
   and the note saying which BIDS field it was derived from. */
QLabel#cff-key-required    { color: $error;   font-weight: 600; }
QLabel#cff-key-recommended { color: $warning; font-weight: 600; }
QLabel#cff-key-optional    { color: $muted;   font-weight: 600; }
QLabel#cff-source          { color: $muted; }

/* The rename dry run: every file the rename would move, tickable, grouped by
   the folder it lives in. Monospace because a plan is a list of names, and
   lining "sub-02_ses-post_T2w" up under "sub-01_ses-post_T2w" is what makes
   the difference visible at a glance. The checkbox styling matches the filter
   tree's so the two read as the same control. */
QTreeWidget#check-tree {
    background: $bg;
    color: $text;
    border: 1px solid $input_border;
    border-radius: 6px;
    font-size: 11px;
}
QTreeWidget#check-tree::item { padding: 2px 0; }
QTreeWidget#check-tree::indicator {
    width: 13px; height: 13px;
    border: 1px solid $border;
    background: $bg;
    border-radius: 3px;
}
QTreeWidget#check-tree::indicator:checked {
    background: $accent;
    border: 1px solid $accent;
}
QTreeWidget#check-tree::indicator:indeterminate {
    background: $accent_bg;
    border: 1px solid $accent;
}

/* ---------------------------------------------------------------------------
 * Dashboard
 *
 * A headline number and its caption, and the chips saying which of the files
 * that describe a dataset are present. Sizes in px so they follow the font
 * scale, like everything else painted rather than laid out.
 * ------------------------------------------------------------------------ */
QLabel#stat-value-text { color: $text;    font-size: 20px; font-weight: 600; }
QLabel#stat-value-err  { color: $error;   font-size: 20px; font-weight: 600; }
QLabel#stat-value-warn { color: $warning; font-size: 20px; font-weight: 600; }
QLabel#stat-caption {
    color: $dim;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
}
QLabel#dash-have {
    color: $success;
    background: $success_bg;
    border: 1px solid $success_border;
    border-radius: 8px;
    padding: 2px 8px;
    font-size: 10px;
}

/* The small word that says what the next line of a finding IS. The parts used
   to run together: a rule id, a message and a schema path stacked with nothing
   telling them apart. */
QLabel#val-caption {
    color: $dim;
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.07em;
}

/* The fold / unfold pair in the dataset tree header. One control, so one
   rounded outline with a divider between the halves rather than two separate
   buttons that happen to sit next to each other. */
QWidget[navGroup="true"] { background: transparent; }
/* The tree's collapse / open-a-level pair: quiet icons, no outline, a
 * hover tint, like every other icon in a panel header. */
QPushButton#tree-nav-left, QPushButton#tree-nav-right {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 0px;
    min-width: 0;
}
QPushButton#tree-nav-left:hover, QPushButton#tree-nav-right:hover {
    background: $surface3;
}
QPushButton#tree-nav-left:pressed, QPushButton#tree-nav-right:pressed {
    background: $accent_bg;
}
QPushButton#tree-nav-right:disabled { background: transparent; }

/* A button whose face is one glyph (the minus that removes an entry, the
 * cross that unlinks): no padding, so the glyph fits its fixed width. */
QPushButton#glyph-btn {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 0px;
    min-width: 0;
    color: $dim;
    font-size: 14px;
}
QPushButton#glyph-btn:hover { background: $surface3; color: $text; }
QPushButton#glyph-btn:pressed { background: $accent_bg; }
QPushButton#glyph-btn:disabled { color: $muted; }

/* The validation pane's own severity filter row. */
QFrame#val-filter-row { background: transparent; border: none; }

/* The Log tab's corner icons sit on the tab bar, not in a header. */
QWidget#dock-corner { background: transparent; }
